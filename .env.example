# ProdLLM Gateway Environment Variables

APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Auth & Security
REQUIRE_AUTH=false
ADMIN_API_KEY=pllm_admin_secret_key_prodllm

# Database & Cache
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/prodllm
USE_SQLITE_FALLBACK=true
FALLBACK_SQLITE_URL=sqlite+aiosqlite:///./prodllm.db
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# LLM Provider Credentials
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_DEFAULT_MODEL=gemini-1.5-flash

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.2-3b-instruct:free

AGNES_API_KEY=your_agnes_api_key_here
AGNES_BASE_URL=https://api.agnes.ai/v1
AGNES_DEFAULT_MODEL=agnes-standard

# Reliability & Policies
ROUTING_STRATEGY=auto
HEDGING_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=60
DEFAULT_DAILY_TOKEN_QUOTA=500000

# Observability
PROMETHEUS_ENABLED=true
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
